
# ---- 兼容OpenAI的模型配置 ----
MODEL_NAME=your-openai-model-name
MODEL_BASE_URL=your-openai-model-base-url
MODEL_API_KEY=your-deepseek-api-key

# ---- OpenSandbox 沙盒 ----
OPENSANDBOX_SERVER_URL=your-sandbox-server-url
OPENSANDBOX_API_KEY=your-opensandbox-api-key
SANDBOX_TIMEOUT_HOURS=24

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DB_NAME=MiloAgent

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 搜索工具（可选）----
TAVILY_API_KEY=tvly-dev-...
