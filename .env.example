# ---- LLM 模型配置 ----
DEEP_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
ANTHROPIC_API_KEY=your-api-key

# ---- DeepSeek 模型 ----
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# ---- LangSmith 追踪（可选）----
LANGSMITH_API_KEY=lsv2_...

# ---- OpenSandbox 沙盒 ----
OPENSANDBOX_SERVER_URL=http://182.254.183.29:8080/
OPENSANDBOX_API_KEY=your-opensandbox-api-key
SANDBOX_TIMEOUT_HOURS=24

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=MiloAgent
USE_MONGO_PERSISTENCE=true

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 搜索工具（可选）----
TAVILY_API_KEY=tvly-dev-...
